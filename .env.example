# The address your clients use: what you type into UwULock, the Bitwarden browser extension and
# the Bitwarden apps as "server URL". https://vault.example.com
UWULOCK_PUBLIC=https://vault.example.com

# Image tag: latest (stable releases), beta (every release), edge (every commit on main)
# or an exact version like 0.1.0. sudo bash update.sh --version <tag> switches it.
UWULOCK_VERSION=latest

# Where the certificate comes from.
#   acme   The server gets one from Let's Encrypt for the name in UWULOCK_PUBLIC and renews it
#          itself. That name has to point to this machine, and port 443 has to reach the server
#          (UWULOCK_BIND=443).
#   off    A reverse proxy in front does TLS and passes plain HTTP on. Then UWULOCK_BIND should be
#          127.0.0.1:<port>, so nothing but the proxy reaches the server, and
#          UWULOCK_TRUST_FORWARDED=on, so the server sees who is asking and not only the proxy.
#   files  Your own certificate: UWULOCK_TLS_CERT and UWULOCK_TLS_KEY, PEM files inside the
#          container (docs/deployment.md shows how to mount them). Read again when they change.
UWULOCK_TLS=acme

# Where the server listens on this machine: a port, or an address:port like 127.0.0.1:8443.
UWULOCK_BIND=443

# Let's Encrypt writes here when a certificate is about to run out without being renewed.
# Optional. The directory is letsencrypt, or staging while you are trying things out.
#UWULOCK_ACME_EMAIL=admin@example.com
#UWULOCK_ACME_DIRECTORY=letsencrypt

# Only behind a proxy that sets X-Forwarded-For: anyone can send that header to a server that
# believes it.
UWULOCK_TRUST_FORWARDED=off

# Once a day the server asks GitHub whether there is a newer release, and says so in its log.
# It is the only connection the server opens on its own, besides Let's Encrypt; off stops it.
UWULOCK_UPDATE_CHECK=on
