# syntax=docker/dockerfile:1.7
#
# Packages the binaries CI built before: dist/amd64/uwulock-server and dist/arm64/uwulock-server.
# docker/Dockerfile builds the same image from source.

# The preparation runs on the machine that builds, whatever the image is for: it only copies and
# sets modes, so nothing has to be emulated. Pinned by digest, like the runtime below.
FROM --platform=$BUILDPLATFORM debian:trixie-slim@sha256:a99cfc517144bc59b1978475ec53b46ecabec7e43635402ee5b77cc54cd1b20a AS prep
ARG TARGETARCH
COPY dist/${TARGETARCH}/uwulock-server /usr/local/bin/uwulock-server
RUN chmod 755 /usr/local/bin/uwulock-server \
 && install -d -o 10001 -g 10001 /data

# Distroless, pinned by digest: see docker/Dockerfile for why.
FROM gcr.io/distroless/cc-debian13@sha256:4594d59540d1948417f6ca2829ddd9294493a7c68b7528f4dd459de7f203a750
COPY --from=prep /usr/local/bin/ /usr/local/bin/
COPY --from=prep --chown=10001:10001 /data /data
USER 10001:10001
ENV UWULOCK_DATA=/data \
    UWULOCK_LISTEN=0.0.0.0:8443 \
    HOME=/data
VOLUME /data
EXPOSE 8443
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --start-interval=2s --retries=3 \
    CMD ["/usr/local/bin/uwulock-server", "health"]
ENTRYPOINT ["/usr/local/bin/uwulock-server"]
CMD ["serve"]
